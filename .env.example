# Chromecast 音量制御の設定

# 20:00 の nemucast-standby（nemucast-20）の対象。運用では「リビングルーム」に設定する。
# nemucast-tv-pair / 手動 nemucast も参照する。コードの既定値は Dell（従来どおり）
CHROMECAST_NAME="リビングルーム"

# ログ・state JSON の出力先ディレクトリ
LOG_DIR="logs"

# 1回の定期実行で下げる音量幅（負の値）
STEP=-0.04

# これ以上は下げない最小音量レベル
MIN_LEVEL=0.3

# スケジューラから呼び出される間隔（秒）
INTERVAL_SEC=1200

# 手動で音量が上げられない状態が何回続いたら standby にするか
INACTIVE_THRESHOLD=3

# 手動で音量が上がったと判定する最小差分
MANUAL_RISE_THRESHOLD=0.01

# 活動判定用 state JSON の保存先
STATE_FILE="logs/activity_state.json"

# state を古いとみなす倍率。実際の猶予秒数は INTERVAL_SEC x この値
STATE_STALE_INTERVAL_MULTIPLIER=2

# standby になるまで interval ごとに繰り返し実行するか
RUN_UNTIL_STANDBY=0

# nemucast-auto（15分間隔の自動寝かしつけ）専用の設定
# 夜間窓の対象はモニターに挿した Chromecast「Dell」。リビングルームには向けない。
# 対象を変更する時は CEO に確認する（CHROMECAST_NAME とは独立）
AUTO_TARGET_NAME="Dell"

# これ以上は下げない最小音量レベル
AUTO_MIN_LEVEL=0.05

# 何回連続で音量を下げたら元の音量へ戻して電源OFFを試すか。
# ペアリング済みなら Android TV Remote の POWER、未ペアリングなら quit_app を試すところまで
AUTO_LOWERED_THRESHOLD=3

# nemucast-auto 用 state JSON の保存先（nemucast 手動実行とは別ファイルにする）
AUTO_STATE_FILE="logs/auto_standby_state.json"

# これ以上間が空いた state は連続カウントを捨てて数え直す秒数（15分間隔 x 2）
AUTO_STATE_STALE_SEC=1800

# nemucast-auto を動かす夜間窓（ローカル時刻 HH:MM。日付またぎ可、終了時刻は含めない）
# 窓外は新規セッションを開始しない。新鮮な進行中セッションは完走、stale なら音量復元だけ行う
AUTO_NIGHT_START="21:00"
AUTO_NIGHT_END="06:00"

# 1 なら夜間窓の判定を無視する（昼間の動作確認用。常用しない）
AUTO_NIGHT_FORCE=0

# 1 なら電源OFFの直前（テレビが点いている間）に、セッション開始時の音量へ戻す。
# 戻さないと翌日のテレビが小さい音量のままになる
AUTO_RESTORE_VOLUME=1

# 音量復元後、テレビが反映した値を読み戻して確かめる待ち時間（秒）。
# 反映前に電源を切ると翌日の音量が 0 になった。確認できなくても電源OFFは続行し WARNING を出す
AUTO_RESTORE_WAIT_SEC=5

# 読み戻しで元の音量とみなす許容差
AUTO_RESTORE_TOLERANCE=0.015

# LAN 上の Chromecast が 1 台も見えない状態に入った時・抜けた時に 1 回ずつ実行する通知コマンド
# 本文を末尾の引数として渡す。空なら通知しない
DISCOVERY_ALERT_COMMAND=""

# 通知済みかを覚えるフラグファイル
DISCOVERY_ALERT_FILE="logs/discovery_alert_state.json"

# LAN 上 0 台が何回続いたら障害とみなすか。0 なら判定しない（LAN に対象 1 台だけの家庭向け）
DISCOVERY_ALERT_AFTER_TICKS=2

# 発見一覧に目的名があるのに接続候補が空の時の追加探索回数（初回を除く）
DISCOVERY_MAX_RETRIES=3

# 追加探索前の待ち秒数
DISCOVERY_RETRY_WAIT_SEC=1

# 夜間窓内の目的名不在が何 tick 続いたら一度通知するか（15 分間隔で約 1 時間）。0 で無効
AUTO_NOT_FOUND_ALERT_AFTER_TICKS=4

# 目的名不在の回数・通知済みフラグ。LAN 0 台検知のファイルとは分ける
AUTO_NOT_FOUND_ALERT_FILE="logs/auto_not_found_alert_state.json"

# 未ペアリングで電源を切れない時の通知日（YYYY-MM-DD）。通知はローカル日付で 1 日 1 回まで。
# 通知失敗時は成功日を記録せず再送待ちだけ保持し、次 tick で再送する。
# ペアリング済みになった場合は再送待ちを解除して通知しない。
# Dell は 2026-11-10 にペアリング済み。電源 OFF 経路は読み取りだけ確認済み（実際に切る試験は未実施）
AUTO_POWER_OFF_ALERT_FILE="logs/auto_power_off_alert_state.json"

# Chromecast を quit_app した後、standby 完了を待つ秒数
STANDBY_WAIT_SEC=2

# 接続確立を待つ秒数。超えたらエラー終了する（無限待ちでプロセスが溜まるのを防ぐ）
CONNECT_TIMEOUT_SEC=30

# ログローテーション設定（RotatingFileHandler）
LOG_ROTATION_MAX_BYTES=524288
LOG_ROTATION_BACKUP_COUNT=1

# テレビ本体の電源制御 (nemucast-standby / nemucast-tv-pair)
# ペアリングの証明書・鍵の置き場所（Git 管理外。0600）
TV_CERT_DIR="~/.config/nemucast"
# 電源OFFに送るキー。この機種は SLEEP が無反応で POWER が有効（トグルなので is_on を見てから送る）
TV_POWER_KEY="POWER"
# 送信後に is_on=False を待つ秒数 / 送信の最大回数
TV_POWER_WAIT_SEC=10
TV_POWER_MAX_ATTEMPTS=3
